# ==============================================================================
# Equator Corporate Portal — PRODUCTION .env template (fill-ready)
# ------------------------------------------------------------------------------
# Copy this to `.env` ON THE SERVER ONLY. Never commit a filled copy to git.
# Fill every <PLACEHOLDER>. Leave APP_KEY empty here and generate it on the
# server (`php artisan key:generate`), OR paste the key you stored in your vault.
#
# Mail is NOT configured here — Brevo SMTP is set at runtime in
# Admin → Settings → Email (BrevoMailConfigurator reads it from the DB, not .env).
#
# After finalizing this file run:  php artisan config:cache route:cache view:cache
# Maps to docs/go-live-checklist.md D5. See header of .env.example for rationale.
# ==============================================================================

APP_NAME="Equator Corporate Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://<your-domain>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Logging — daily rotation, 14-day window. `warning` avoids verbose/sensitive logs.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database — create a NEW MySQL DB + user in cPanel → MySQL Databases.
# cPanel prefixes names with your account, e.g. cpaneluser_equator.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<cpaneluser_dbname>
DB_USERNAME=<cpaneluser_dbuser>
DB_PASSWORD=<strong-db-password>

# Sessions + jobs tables are migrated. There is NO cache table → cache uses file.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=false
# MUST be true in production (HTTPS) — cookie is then never sent over HTTP.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Async mail/jobs drained by the single schedule:run cron. Do NOT ship `sync`.
QUEUE_CONNECTION=database

# No cache table by default → file store. If sharing one store across sites,
# set a unique CACHE_PREFIX per site to namespace keys.
CACHE_STORE=file
CACHE_PREFIX=equator_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail fallbacks only — real SMTP is configured in Admin → Settings → Email (Brevo).
# Leaving `log` here is safe; queued mail uses the CMS-configured Brevo transport.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="<no-reply@your-domain>"
MAIL_FROM_NAME="${APP_NAME}"

# Optional Brevo fallbacks (normally left blank — set via Admin Settings instead).
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_ENCRYPTION=tls
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile — protects the public contact form. Issue keys at
# dash.cloudflare.com → Turnstile. SITE key is public; SECRET key is server-only.
TURNSTILE_SITE_KEY=<turnstile-site-key>
TURNSTILE_SECRET_KEY=<turnstile-secret-key>

# ------------------------------------------------------------------------------
# Off-site backup (D4) — OPTIONAL but recommended for true disaster recovery.
# Unset = backups stay LOCAL ONLY (storage/app/backups), lost with the server.
# To enable, define an 's3'/'ftp'/'sftp' disk and its credentials, then point at it:
# ------------------------------------------------------------------------------
# BACKUP_OFFSITE_DISK=s3
# BACKUP_OFFSITE_PATH=equator-backups
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=true        # true for Backblaze B2 / Wasabi / MinIO
# Optional retention overrides: BACKUP_KEEP_DAILY / WEEKLY / MONTHLY, BACKUP_DAILY_FILES

# Optional: push critical (warning+) logs to Slack at zero cost.
# Use LOG_STACK=daily,slack together with this URL.
# LOG_SLACK_WEBHOOK_URL=
