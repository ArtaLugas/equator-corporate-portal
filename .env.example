# ==============================================================================
# Equator Corporate Portal — environment template
# ------------------------------------------------------------------------------
# Copy to `.env` for local dev (`cp .env.example .env`), then `php artisan key:generate`.
#
# PRODUCTION CHECKLIST (override these on the live server):
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://your-domain
#   SESSION_SECURE_COOKIE=true          # cookies only over HTTPS
#   LOG_LEVEL=warning                   # avoid verbose/sensitive logs
#   Run: php artisan config:cache route:cache view:cache
#   Add ONE cPanel cron (every minute) running `artisan schedule:run` — it drives
#   both analytics pruning and the queue (emails). See deploy/README.md.
# ==============================================================================

APP_NAME="Equator Corporate Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Logging — `daily` rotates and bounds disk usage (vs a single ever-growing file).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=equator_corporate_portal
DB_USERNAME=root
DB_PASSWORD=

# Single-server defaults. The `sessions` and `jobs` tables are migrated;
# there is no `cache` table, so cache uses the file store.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=false
# Set to true in production (HTTPS) so the session cookie is never sent over HTTP.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail is queued and processed by the scheduler (one cPanel cron, no daemon).
# Without that cron, queued emails won't send — see deploy/README.md.
# For low volume you may set QUEUE_CONNECTION=sync to send inline instead.
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

# Admin audit-log retention: the scheduled prune deletes activity_logs rows older
# than this many days (default 365). Set to 0 to keep the audit trail forever.
ACTIVITY_LOG_RETENTION_DAYS=365

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. Defaults to the `log` driver (writes emails to the log) for local dev.
# Production SMTP for transactional mail is managed at runtime from the CMS
# Settings screen (Brevo); the values below are fallbacks only.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo SMTP (fallbacks; usually configured via the admin Settings screen).
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_ENCRYPTION=tls
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile (free CAPTCHA) — issue keys at dash.cloudflare.com → Turnstile.
# SITE key is public (sent to the browser); SECRET key is server-only — never expose it.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: send critical logs to Slack.
# LOG_SLACK_WEBHOOK_URL=
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=
